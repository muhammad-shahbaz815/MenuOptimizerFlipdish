{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "menu-optimizer-flipdish",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "menu-optimizer-flipdish-db",
      "database_id": "3c8aafec-3743-4d46-bd45-9786aa66876d"
    }
  ],
  // Custom domain (optional): pick ONE hostname under a Flipdish-managed zone.
  // Available zones: *.flipdish.com (production) or *.flipdishlabs.com (labs/staging).
  // Uncomment a single route entry and set NEXTAUTH_URL + Google OAuth to the same origin.
  // "routes": [
  //   {
  //     "pattern": "menu-optimizer-flipdish.flipdish.com",
  //     "custom_domain": true
  //   }
  //   // Or use the labs zone instead:
  //   // {
  //   //   "pattern": "menu-optimizer-flipdish.flipdishlabs.com",
  //   //   "custom_domain": true
  //   // }
  // ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "menu-optimizer-flipdish"
    }
  ]
}
